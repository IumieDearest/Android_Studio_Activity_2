<?xml version="1.0" encoding="utf-8"?>
<!-- MAIN DASHBOARD (res/layout/activity_dashboard.xml)
     Shown after the OTP is verified. Same style as the other screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <!-- gravity="center_vertical" puts everything in the middle of the screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== TITLE AND SUBTITLE ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_dashboard"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle_dashboard"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ===== CUSTOMERS BUTTON (black pill) ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCustomers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/btn_customers"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/black"
            app:cornerRadius="28dp" />

        <!-- ===== LOG OUT BUTTON (white with a border) ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogOut"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_log_out"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:strokeColor="@color/divider" />

    </LinearLayout>
</ScrollView>