<?xml version="1.0" encoding="utf-8"?>
<!-- OTP SCREEN (res/layout/activity_otp.xml)
     Same style as the login and sign up screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== BACK ARROW (goes back to the login screen) ===== -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_back"
            android:src="@drawable/ic_arrow_back" />

        <!-- ===== TITLE AND SUBTITLE ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/title_verify"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/subtitle_otp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ===== DEMO CODE BOX =====
             Since we don't send real text messages, the code from the
             server is shown here. The text is set in OtpActivity.java. -->
        <TextView
            android:id="@+id/tvDemoCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- ===== OTP INPUT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_otp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- inputType="number" shows the number keypad.
             maxLength="4" stops the user from typing more than 4 digits.
             letterSpacing spreads the digits apart so they're easy to read. -->
        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:autofillHints="smsOTPCode"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="@string/hint_otp"
            android:inputType="number"
            android:letterSpacing="0.5"
            android:maxLength="4"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ===== COUNTDOWN TIMER TEXT (updated every second in Java) ===== -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ===== VERIFY BUTTON (black pill) ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_verify"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/black"
            app:cornerRadius="28dp" />

        <!-- ===== BOTTOM LINK: "Didn't get a code? Resend" ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_code"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- This TextView acts as the Resend button -->
            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:padding="4dp"
                android:text="@string/resend"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>