<?xml version="1.0" encoding="utf-8"?>
<!-- USERS SCREEN (res/layout/activity_users.xml)
     Shown after the OTP is verified. Same style as the other screens:
     a title, a subtitle, a table of users, and a black button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== TITLE ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/title_users"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- ===== SUBTITLE: shows "Loading users…" first, then the number of users.
             The text is set in UsersActivity.java. ===== -->
        <TextView
            android:id="@+id/tvUserCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ===== THE TABLE =====
             TableLayout arranges rows (TableRow) into columns, a bit like a JTable in Swing.
             stretchColumns="*" lets all columns share the full width.
             shrinkColumns="2" lets the Email column (column 2, counting from 0)
             wrap onto two lines if an email is very long.
             padding="1dp" keeps the header from covering the grey border. -->
        <TableLayout
            android:id="@+id/tableUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_table"
            android:padding="1dp"
            android:shrinkColumns="2"
            android:stretchColumns="*">

            <!-- HEADER ROW (the user rows are added below this in Java) -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_table_header">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/header_number"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/header_name"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="@string/header_email"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </TableRow>

        </TableLayout>

        <!-- ===== LOG OUT BUTTON (black pill) ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogOut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_log_out"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/black"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>